# Admin-uploaded content. Keep the folders (index.html) but not the uploaded files.
# images/brand/ holds the Blossom fallback logos, which are part of the theme.
/assets/frontend/images/*/*
!/assets/frontend/images/*/index.html
!/assets/frontend/images/brand/**
/assets/uploads/*/*
!/assets/uploads/*/index.html
