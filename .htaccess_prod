# -----------------------------------------------------------------------------
# Production .htaccess for the CodeIgniter 3 application.
#
# Deploy by uploading this file to the web root as ".htaccess" (replacing the
# development one). Requires Apache 2.4 with AllowOverride enabled.
# Every module-specific block is wrapped in <IfModule> so a missing module
# degrades gracefully instead of returning a 500 error.
# -----------------------------------------------------------------------------

# Force production mode (index.php reads CI_ENV; defaults to development).
<IfModule mod_env.c>
    SetEnv CI_ENV production
</IfModule>

# Never list directory contents and stop MultiViews from guessing filenames.
Options -Indexes -MultiViews

DirectoryIndex index.php

# Character set for text responses.
AddDefaultCharset UTF-8

# Do not expose the ETag inode/mtime fingerprint; caching relies on
# Cache-Control / Expires + Last-Modified below.
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None


# -----------------------------------------------------------------------------
# URL rewriting
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (also works behind a proxy/load balancer that sets
    # X-Forwarded-Proto).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Optional: canonical host. Uncomment ONE block and replace example.com.
    #
    # Non-www -> www
    # RewriteCond %{HTTP_HOST} ^example\.com$ [NC]
    # RewriteRule ^ https://www.example.com%{REQUEST_URI} [R=301,L]
    #
    # www -> non-www
    # RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
    # RewriteRule ^ https://example.com%{REQUEST_URI} [R=301,L]

    # Block direct web access to application internals, VCS data, database
    # dumps and logs. (application/ and system/ also carry their own
    # .htaccess as a second layer.)
    RewriteRule ^(application|system|database|db|docs|email_logs|cgi-bin|\.git|\.claude|\.vscode)(/|$) - [F,L]

    # Block project/config files that must not be served.
    RewriteRule ^(composer\.(json|lock)|AGENTS\.md|CLAUDE\.md|PROJECT_PLAN\.md|\.gitignore)$ - [F,L]

    # Block uploaded scripts from ever executing, even if a bad upload slips
    # through validation. Static uploads are still served normally.
    RewriteRule ^assets/(uploads|ckfinder/userfiles)/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp)$ - [F,L]

    # Front controller: send everything that is not a real file, directory or
    # symlink to index.php (same rule as the development .htaccess). B escapes
    # the copied path: Apache 2.4.56+ refuses a rewritten query string with
    # spaces (AH10411), which broke multi-word admin searches.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-l
    RewriteRule ^(.+)$ index.php?url=$1 [B,QSA,L]
</IfModule>

# Deny hidden files and folders (.env, .git, .htpasswd, ...). The ACME
# challenge folder is kept reachable for Let's Encrypt renewals.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

# Deny backup, dump and source-control leftovers anywhere in the tree.
<FilesMatch "(^#.*#|\.(bak|ini|log|old|orig|sql|sh|swp|tmp|dump)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom error pages are handled by CodeIgniter (404 via routes), so no
# ErrorDocument directives are needed here.


# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # HSTS: enable only once HTTPS works for the whole domain and every
    # subdomain you serve. Start with a short max-age, then raise it.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Content-Security-Policy is intentionally not set: the site uses
    # third-party scripts/styles/fonts and inline code, so a policy must be
    # built and tested against the real page assets first.

    # Hide the PHP version if PHP runs as an Apache module.
    Header unset X-Powered-By
</IfModule>


# -----------------------------------------------------------------------------
# Compression (gzip / deflate). Images, video and archives are already
# compressed and are deliberately left out.
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE application/manifest+json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject

    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>


# -----------------------------------------------------------------------------
# MIME types (covers older servers missing modern types)
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType application/json .json
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType application/vnd.ms-fontobject .eot
</IfModule>


# -----------------------------------------------------------------------------
# Browser caching
#
# Dynamic pages (PHP output) are not cached here - CodeIgniter controls those.
# CSS/JS are cached for a week because filenames are not fingerprinted; if you
# add ?v= cache-busting or hashed filenames, raise them to 1 year + immutable.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"

    # Images and icons
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # Stylesheets and scripts
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"

    # Media
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"

    # Documents and feeds
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # Long-lived static assets can be shared by proxies/CDNs.
    <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|mp4|webm|mp3)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Fonts loaded cross-origin (e.g. from a CDN sub-domain) need CORS.
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>


# -----------------------------------------------------------------------------
# PHP settings (only applied when PHP runs as an Apache module; on PHP-FPM /
# FastCGI set these in php.ini or .user.ini instead).
# -----------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
